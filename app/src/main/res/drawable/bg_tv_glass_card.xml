<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2A00F0FF"
                android:endColor="#20152438" />
            <stroke
                android:width="1.8dp"
                android:color="#00F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2000F0FF"
                android:endColor="#18182436" />
            <stroke
                android:width="1.5dp"
                android:color="#8000F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B30F1726"
                android:endColor="#990A0F1A" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
