<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2500F0FF"
                android:endColor="#1815253A" />
            <corners android:radius="8dp" />
            <stroke android:width="1.8dp" android:color="@color/tv_accent_cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B121C" />
            <stroke android:width="1.8dp" android:color="@color/tv_accent_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141E2E" />
            <stroke android:width="1dp" android:color="#243449" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
