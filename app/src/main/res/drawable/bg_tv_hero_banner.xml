<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E3A5F"
                android:centerColor="#14243B"
                android:endColor="#0B1320" />
            <stroke android:width="2dp" android:color="@color/tv_card_stroke_focused" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#162234"
                android:centerColor="#0F1724"
                android:endColor="#070A0F" />
            <stroke android:width="1dp" android:color="@color/tv_card_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
