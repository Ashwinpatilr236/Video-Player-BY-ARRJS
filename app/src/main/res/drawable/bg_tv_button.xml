<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A283C"
                android:endColor="#121C2B" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/tv_accent_cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B121C" />
            <stroke android:width="2dp" android:color="@color/tv_accent_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_bg_card" />
            <stroke android:width="1dp" android:color="@color/tv_card_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
