<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#80182336" android:endColor="#40182336" android:angle="135"/>
            <stroke android:width="2dp" android:color="@color/tv_focus_ring" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#40111722" android:endColor="#10111722" android:angle="135"/>
            <stroke android:width="1dp" android:color="#20FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
