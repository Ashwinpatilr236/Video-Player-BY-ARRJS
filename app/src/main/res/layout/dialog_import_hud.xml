<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_glass_modal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Header with Live Pulse -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Sync"
            android:src="@drawable/ic_playlist_add"
            app:tint="@color/tv_accent_cyan" />

        <TextView
            android:id="@+id/tvHudTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Importing IPTV Playlist"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHudStatusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Establishing connection with stream server..."
        android:textColor="@color/tv_text_secondary"
        android:textSize="14sp" />

    <!-- Sleek Progress Bar -->
    <ProgressBar
        android:id="@+id/pbHudProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="15"
        android:progressTint="@color/tv_accent_cyan" />

    <!-- Live Metrics Counter Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tv_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Data Downloaded:"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHudBytesDownloaded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 MB"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channels Parsed:"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHudChannelsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 channels"
                android:textColor="@color/tv_accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categories Grouped:"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHudCategoriesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 categories"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Summary Breakdown Card (Visible on Completion) -->
    <LinearLayout
        android:id="@+id/layoutHudSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tv_glass_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Import Complete &amp; Indexed"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHudSummaryDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ready for 4K streaming. EPG guide linked."
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHudDismiss"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:text="Done"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
