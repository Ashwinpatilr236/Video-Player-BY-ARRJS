<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_glass_modal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Parental Control"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter 4-Digit Security PIN to access"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etParentalPinInput"
        android:layout_width="180dp"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tv_glass_card"
        android:gravity="center"
        android:hint="••••"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.3"
        android:maxLength="4"
        android:textColor="@color/tv_accent_cyan"
        android:textColorHint="@color/tv_text_muted"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Incorrect PIN. Please try again."
        android:textColor="@color/tv_accent_red"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelPin"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:text="Cancel"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConfirmPin"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:text="Unlock"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
