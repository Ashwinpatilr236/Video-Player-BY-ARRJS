<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_glass_modal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Header with Gold Pro Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="VIP"
            android:src="@drawable/ic_favorite_filled"
            app:tint="#FFB300" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Unlock ARRJS TV Premium"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPremiumStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pro_badge"
            android:text="VIP ACCESS"
            android:textColor="#050912"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Get full access to all professional TV features and unlimited playlists."
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp" />

    <!-- Feature Checklist Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tv_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Unlimited Playlists (M3U &amp; Xtream Codes)"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✓ Multi-View Dual Screen (Watch 2 Live channels at once)"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✓ Parental Control &amp; 4-Digit Category PIN Lock"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✓ Voice Boost (+12dB) &amp; 5.1 Dolby Audio Passthrough"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✓ Auto-Play Next Episode &amp; Subtitle Sync"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Activation Code Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter License / Activation Code:"
        android:textColor="@color/tv_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etActivationCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tv_glass_card"
        android:hint="e.g. ARRJS-PRO-2026"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_muted"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelActivation"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tv_button"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="Close"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnActivateLicense"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_button"
            app:backgroundTint="@null"
            android:focusable="true"
            android:text="⚡ Activate License"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
