<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/brand_subtitle"
        android:textColor="@color/tv_accent_cyan"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Column: Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnAddM3u"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/settings_add_m3u"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAddXtream"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/settings_add_xtream"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnResetSampleStreams"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Restore Demo Test Streams"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnClearData"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="20dp"
                android:text="Clear Watch History &amp; Cache"
                android:textColor="@color/tv_accent_red"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Right Column: About ARRJS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="0.45"
            android:background="@drawable/bg_tv_card"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tv_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_app_version"
                android:textColor="@color/tv_accent_cyan"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Optimized native Android TV IPTV player engineered with AndroidX Media3 ExoPlayer engine, HLS multi-bitrate streaming, robust M3U parsing, and 100% remote D-pad navigability."
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_copyright"
                android:textColor="@color/tv_text_muted"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
