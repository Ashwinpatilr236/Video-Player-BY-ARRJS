<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Media3 PlayerView (Pure Edge-to-Edge) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Buffering Indicator Overlay -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_tv_quick_banner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/tv_accent_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/player_buffering"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Playback Error State Overlay -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_tv_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_error_title"
            android:textColor="@color/tv_accent_red"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/player_error_desc"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:text="@string/player_retry"
                android:textColor="@color/tv_text_primary" />

            <Button
                android:id="@+id/btnBackToGuide"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:text="@string/player_back_to_guide"
                android:textColor="@color/tv_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- DTH Style Quick Channel Switch Banner (Shown on D-pad Up/Down) -->
    <LinearLayout
        android:id="@+id/layoutQuickBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_tv_quick_banner"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Channel Number Badge -->
        <TextView
            android:id="@+id/tvQuickChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="101"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/tv_card_stroke" />

        <ImageView
            android:id="@+id/imgQuickLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tv_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvQuickChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvQuickCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="@color/tv_text_muted" />

                <TextView
                    android:id="@+id/tvQuickProgram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Stream Broadcast (HLS)"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="@drawable/bg_tv_live_pill"
            android:text="@string/player_live"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full On-Screen Display (OSD) Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutOsd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Top Gradient Vignette Bar -->
        <LinearLayout
            android:id="@+id/layoutTopInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_gradient_top_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="36dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgOsdLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tv_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOsdChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOsdCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_accent_cyan"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tv_live_pill"
                android:text="@string/player_live"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Gradient Vignette Bar -->
        <LinearLayout
            android:id="@+id/layoutBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_gradient_bottom_overlay"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="36dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnPrevChannel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_channel_down"
                android:focusable="true"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="Play or Pause"
                android:focusable="true"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnNextChannel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_channel_up"
                android:focusable="true"
                android:src="@drawable/ic_play" />

            <!-- Seek bar for VOD/catchup -->
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:focusable="true"
                android:progressTint="@color/tv_accent_cyan"
                android:thumbTint="@color/tv_accent_cyan" />

            <TextView
                android:id="@+id/tvTimeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="LIVE"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAspectRatio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_aspect_ratio"
                android:focusable="true"
                android:src="@drawable/ic_aspect_ratio" />

            <ImageButton
                android:id="@+id/btnVideoQuality"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_video_quality"
                android:focusable="true"
                android:src="@drawable/ic_video_quality" />

            <ImageButton
                android:id="@+id/btnAudioBoost"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_voice_boost"
                android:focusable="true"
                android:src="@drawable/ic_volume_boost" />

            <ImageButton
                android:id="@+id/btnAudioTracks"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_audio_tracks"
                android:focusable="true"
                android:src="@drawable/ic_audio" />

            <ImageButton
                android:id="@+id/btnSubtitles"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_subtitles"
                android:focusable="true"
                android:src="@drawable/ic_subtitles" />

            <ImageButton
                android:id="@+id/btnSleepTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_toolbar_icon"
                android:contentDescription="@string/player_sleep_timer"
                android:focusable="true"
                android:src="@drawable/ic_sleep_timer" />

        </LinearLayout>

        <!-- Clean Glassmorphic EPG Information Card (Live TV Style) -->
        <LinearLayout
            android:id="@+id/layoutBottomEpgCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tv_gradient_bottom_overlay"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Channel Number & Large Logo Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tv_glass_pill"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvPlayerEpgNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="101"
                        android:textColor="@color/tv_accent_cyan"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1.5dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@color/tv_card_stroke" />

                    <ImageView
                        android:id="@+id/imgPlayerEpgLogo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tv_logo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPlayerEpgChannelName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPlayerEpgCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_tv_glass_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/tv_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPlayerEpgProgramTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Live Stream Broadcast"
                        android:textColor="#F1F5F9"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Program Schedule Time Badge -->
                <TextView
                    android:id="@+id/tvPlayerEpgTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tv_glass_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="LIVE"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Show Progress Bar -->
            <ProgressBar
                android:id="@+id/pbPlayerEpgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/bg_epg_progress" />

            <!-- Next Up Program Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT ❯ "
                    android:textColor="@color/tv_accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerEpgNext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Live Stream Programming"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Press [OK] for Tools  •  [▲/▼] Switch Channel"
                    android:textColor="@color/tv_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DTH Quick Channel Number Dial Badge (e.g. #105) -->
    <LinearLayout
        android:id="@+id/layoutNumberDial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_tv_card"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CH "
            android:textColor="@color/tv_text_secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="101"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="34sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Glassmorphic Stats for Nerds HUD -->
    <LinearLayout
        android:id="@+id/layoutStatsHud"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_tv_quick_banner"
        android:elevation="24dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAM HEALTH &amp; STATS"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/tv_card_stroke" />

        <TextView
            android:id="@+id/tvStatsResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resolution: Auto"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatsCodecs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Codecs: AVC / AAC"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatsBitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bitrate: Dynamic"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatsDropped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dropped: 0 frames"
            android:textColor="@color/tv_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Favorite Floating Notification Pill -->
    <LinearLayout
        android:id="@+id/layoutFavBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_tv_quick_banner"
        android:elevation="30dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgFavBadgeIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_favorite_filled" />

        <TextView
            android:id="@+id/tvFavBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Added to Favorites"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Mini-Guide Channel Side-Drawer (Over Live Video) -->
    <LinearLayout
        android:id="@+id/layoutMiniGuide"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F0090D15"
        android:elevation="28dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tv_live"
                app:tint="@color/tv_accent_cyan" />

            <TextView
                android:id="@+id/tvMiniGuideTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Quick Channels"
                android:textColor="@color/tv_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMiniGuideCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ch"
                android:textColor="@color/tv_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Press Left for Full TV Guide Shortcut -->
        <LinearLayout
            android:id="@+id/btnMiniGuideFullGuide"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_epg_guide"
                app:tint="@color/tv_accent_cyan" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Full TV Guide"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ Press LEFT"
                android:textColor="@color/tv_accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMiniGuide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true" />
    </LinearLayout>

    <!-- Netflix-Style Next Episode Auto-Play Countdown Card -->
    <LinearLayout
        android:id="@+id/layoutNextEpisodeCard"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_tv_quick_banner"
        android:elevation="35dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextEpisodeCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next Episode in 10s"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNextEpisodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Next Episode"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelNextEpisode"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:text="Cancel"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPlayNextEpisodeNow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_button"
                android:focusable="true"
                android:text="▶ Play Now"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
