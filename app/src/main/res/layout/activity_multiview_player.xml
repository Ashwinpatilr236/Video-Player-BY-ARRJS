<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811"
    android:orientation="vertical">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0A0F1D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MULTI-VIEW DUAL LIVE TV"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pro_badge"
            android:text="PRO"
            android:textColor="#050912"
            android:textSize="9sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvActiveScreenIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Audio: Screen 1 (Left)"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="[Left / Right] Swap Audio • [Up / Down] Surf Channel"
            android:textColor="@color/tv_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dual Screens Container (50% / 50% split) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Screen 1 (Left) -->
        <FrameLayout
            android:id="@+id/frameScreen1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_glass_card"
            android:focusable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:use_controller="false" />

            <!-- Channel Banner 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#CC0A0F1D"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvScreen1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen 1: Loading..."
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Screen 2 (Right) -->
        <FrameLayout
            android:id="@+id/frameScreen2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tv_glass_card"
            android:focusable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:use_controller="false" />

            <!-- Channel Banner 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#CC0A0F1D"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvScreen2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen 2: Loading..."
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
