<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tv_glass_modal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvEditorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Playlist Information &amp; Editor"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEditorSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Manage server connection and channel categories"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tv_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEditorPlaylistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Playlist"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEditorUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:text="http://example.com/playlist.m3u"
            android:textColor="@color/tv_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEditorStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Channels: 0 • Categories: 0"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEditorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Playlist"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditorDelete"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:text="Delete"
            android:textColor="@color/tv_accent_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditorRefresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:text="Sync / Refresh"
            android:textColor="@color/tv_accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditorClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:text="Close"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
